# Copy to .env and replace every placeholder. Never commit .env.

# --- MongoDB Atlas (Atlas -> Connect -> Drivers). Percent-encode special characters in the password. ---
MONGODB_URI=mongodb+srv://plms_app:change-me-db-password@your-cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=plms

# --- Flask / JWT (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too-at-least-32-bytes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- App ---
APP_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
FRONTEND_URL=http://localhost:8080
MAX_UPLOAD_MB=50
LOGIN_RATE_LIMIT=10 per minute
LOG_LEVEL=INFO

# --- Initial administrator (used by `flask create-admin`; entrypoint creates it only if both are set) ---
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-Admin1
